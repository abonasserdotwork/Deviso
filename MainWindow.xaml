<Window x:Class="Deviso.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/Deviso.ico"
        Title="Deviso" Height="900" Width="1440" MinHeight="720" MinWidth="1080"
        Background="#141619" Foreground="#EAECF0" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#233D4D"/>
            <Setter Property="Foreground" Value="#EAECF0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FE7F2D"/>
                                <Setter Property="Foreground" Value="#141619"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#FFB27F"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1C2025"/>
            <Setter Property="Foreground" Value="#EAECF0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#1C2025"/>
            <Setter Property="AlternatingRowBackground" Value="#20282E"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#20272E"/>
            <Setter Property="Foreground" Value="#9AA7B4"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#28343E"/>
                    <Setter Property="Foreground" Value="#F3F5F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#EAECF0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#293239"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#28343E"/>
                    <Setter Property="Foreground" Value="#EAECF0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171C22"/>
            <Setter Property="Foreground" Value="#EAECF0"/>
            <Setter Property="CaretBrush" Value="#FE7F2D"/>
            <Setter Property="BorderBrush" Value="#34414D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#20272E"/>
            <Setter Property="Foreground" Value="#EAECF0"/>
            <Setter Property="BorderBrush" Value="#34414D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="238"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#171C22" BorderBrush="#29323C"
                                    BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TabPanel Grid.Row="0" IsItemsHost="True" KeyboardNavigation.TabIndex="1"
                                              Margin="14,20,14,16" VerticalAlignment="Top"/>
                                    <Border Grid.Row="1" Background="#1E252C" CornerRadius="11"
                                            Margin="14,8,14,18" Padding="13">
                                        <StackPanel>
                                            <TextBlock Text="LOCAL MONITORING" FontSize="9"
                                                       FontWeight="SemiBold" Foreground="#FE9A5A"/>
                                            <TextBlock Text="Refreshes every 5 minutes while Deviso is open."
                                                       FontSize="11" Foreground="#A8B0B8"
                                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <TextBlock Text="Missing SMART values are never estimated."
                                                       FontSize="10" Foreground="#718194"
                                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            <Border Height="1" Background="#34414D" Margin="0,11,0,9"/>
                                            <TextBlock Text="CREATED BY" FontSize="9"
                                                       FontWeight="SemiBold" Foreground="#8593A0"/>
                                            <TextBlock Text="Abonasser.Dev" FontSize="11"
                                                       Foreground="#EAECF0" Margin="0,4,0,0"/>
                                            <TextBlock Text="PROPRIETARY · ALL RIGHTS RESERVED"
                                                       FontSize="8" Foreground="#718194"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent"
                                              Margin="0" KeyboardNavigation.TabIndex="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#A8B0B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="15,13"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Width" Value="208"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent" Background="#FE7F2D" CornerRadius="2"
                                        Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#20272E"/>
                                <Setter Property="Foreground" Value="#EAECF0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#252E36"/>
                                <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FE9A5A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="#171C22" BorderBrush="#29323C"
                BorderThickness="0,0,1,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                <Image Width="44" Height="44" Stretch="Uniform" Margin="0,0,12,0"
                       SnapsToDevicePixels="True">
                    <Image.Source>
                        <BitmapImage DecodePixelWidth="128"
                                     UriSource="pack://application:,,,/Assets/Deviso.ico"/>
                    </Image.Source>
                </Image>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Deviso" FontSize="22" FontWeight="Bold" Foreground="#F3F5F7"/>
                    <TextBlock Text="STORAGE HEALTH" FontSize="9" Foreground="#8593A0"
                               Margin="1,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1" Background="#141619" Margin="28,0,30,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Drive health" FontSize="22" FontWeight="Bold" Foreground="#F3F5F7"/>
                <StackPanel Orientation="Horizontal" Margin="1,5,0,0">
                    <Ellipse x:Name="StatusIndicator" Width="7" Height="7" Fill="#62C99B"
                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="StatusText" Text="Preparing drive scan…" Foreground="#A8B0B8"
                               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="BusyProgress" Width="54" Height="3" Margin="12,0,0,0"
                                 IsIndeterminate="True" Visibility="Collapsed"
                                 Background="#29323C" Foreground="#FE7F2D" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>
            <Button x:Name="RestartAdminButton" Grid.Column="1" Content="Unlock SMART details (Admin)"
                    Click="RestartAdmin_Click" VerticalAlignment="Center" Padding="14,11"
                    Background="#20272E" Margin="0,0,10,0"/>
            <Button x:Name="RefreshButton" Grid.Column="2" Content="↻   Refresh drives"
                    Background="#FE7F2D" Foreground="#141619" FontWeight="SemiBold"
                    Click="Refresh_Click" VerticalAlignment="Center" Padding="18,11" Margin="0"/>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="1" Grid.ColumnSpan="2" TabStripPlacement="Left"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="OVERVIEW">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="26,24,28,16">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Your storage at a glance" FontSize="26"
                                       FontWeight="Bold" Foreground="#F3F5F7"/>
                            <TextBlock Text="Live health and reliability details reported by Windows and your drives."
                                       FontSize="13" Foreground="#9AA7B4" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#1C2025" CornerRadius="13" Padding="18" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="PHYSICAL DRIVES" FontSize="11" Foreground="#A8B0B8"/>
                                    <TextBlock x:Name="DriveCountText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                    <TextBlock Text="Reported by Windows" Foreground="#A8B0B8" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#1C2025" CornerRadius="13" Padding="18" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="WINDOWS HEALTH" FontSize="11" Foreground="#A8B0B8"/>
                                    <TextBlock x:Name="HealthyCountText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                    <TextBlock Text="Drives reporting healthy" Foreground="#A8B0B8" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#1C2025" CornerRadius="13" Padding="18" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="LIFE REMAINING (%)" FontSize="11" Foreground="#A8B0B8"/>
                                    <TextBlock x:Name="LifeSummaryText" Text="Select a drive" FontSize="26" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                    <TextBlock x:Name="LifeSummaryCaption" Text="SMART data depends on drive support" Foreground="#A8B0B8" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="#1C2025" CornerRadius="13" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="WARMEST DRIVE" FontSize="11" Foreground="#A8B0B8"/>
                                    <TextBlock x:Name="TemperatureSummaryText" Text="—" FontSize="26" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                    <TextBlock Text="Reported sensor temperature" Foreground="#A8B0B8" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#1C2025" CornerRadius="13" Padding="17"
                                    Margin="0,0,0,14">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="2,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Your drives" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="Select a drive to inspect its health and SMART details."
                                                       Foreground="#9AA7B4" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" Width="220" VerticalAlignment="Center">
                                            <TextBox x:Name="DriveSearchBox" TextChanged="DriveSearch_TextChanged"
                                                     ToolTip="Search by drive name, volume, health, or interface"
                                                     Padding="32,9,10,9"/>
                                            <TextBlock Text="⌕" FontSize="18" Foreground="#8593A0"
                                                       Margin="11,0,0,0" VerticalAlignment="Center"
                                                       IsHitTestVisible="False"/>
                                            <TextBlock x:Name="DriveSearchHint" Text="Find a drive"
                                                       Foreground="#718194" Margin="34,0,0,0"
                                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Grid>
                                    <Grid>
                                        <DataGrid x:Name="DriveGrid" Height="300" ItemsSource="{Binding Drives}" AlternationCount="2"
                                                  SelectionChanged="DriveGrid_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="DEVICE" Binding="{Binding DisplayName}" Width="2*" MinWidth="155"/>
                                                <DataGridTextColumn Header="MEDIA" Binding="{Binding MediaType}" Width="*" MinWidth="72"/>
                                                <DataGridTextColumn Header="CAPACITY" Binding="{Binding Capacity}" Width="*" MinWidth="92"/>
                                                <DataGridTextColumn Header="HEALTH" Binding="{Binding Health}" Width="*" MinWidth="82"/>
                                                <DataGridTextColumn Header="TEMP" Binding="{Binding TemperatureDisplay}" Width="*" MinWidth="78"/>
                                                <DataGridTextColumn Header="POWER-ON" Binding="{Binding PowerOnDisplay}" Width="*" MinWidth="96"/>
                                                <DataGridTextColumn Header="LIFE REMAINING (%)" Binding="{Binding LifeRemainingDisplay}" Width="*" MinWidth="132"/>
                                                <DataGridTextColumn Header="VOLUME" Binding="{Binding VolumeDisplay}" Width="*" MinWidth="90"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Border x:Name="DriveEmptyState" Background="#1C2025" Visibility="Collapsed">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Margin="24">
                                                <TextBlock x:Name="DriveEmptyTitle" Text="No drives found"
                                                           FontSize="17" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="DriveEmptyMessage"
                                                           Text="Refresh to check for storage devices."
                                                           Foreground="#9AA7B4" Margin="0,7,0,14"
                                                           TextAlignment="Center" TextWrapping="Wrap"/>
                                                <Button Content="Refresh drives" Click="Refresh_Click"
                                                        HorizontalAlignment="Center" Margin="0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Background="#1C2025" CornerRadius="13" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="1,0,0,14">
                                        <TextBlock Text="Selected drive" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SelectedDriveNameText" Text="Choose a drive"
                                                   Foreground="#A8B0B8" Margin="0,4,0,2" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SelectedSourceText" Text="Windows drive status"
                                                   Foreground="#718194" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#171C22" CornerRadius="9" Padding="12" Margin="0,0,9,0">
                                            <StackPanel>
                                                <TextBlock Text="HEALTH" FontSize="9" Foreground="#8593A0"/>
                                                <TextBlock x:Name="SelectedHealthText" Text="—" FontSize="15"
                                                           FontWeight="SemiBold" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="#171C22" CornerRadius="9" Padding="12" Margin="0,0,9,0">
                                            <StackPanel>
                                                <TextBlock Text="TEMPERATURE" FontSize="9" Foreground="#8593A0"/>
                                                <TextBlock x:Name="SelectedTemperatureText" Text="—" FontSize="15"
                                                           FontWeight="SemiBold" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="#171C22" CornerRadius="9" Padding="12" Margin="0,0,9,0">
                                            <StackPanel>
                                                <TextBlock Text="POWER-ON TIME" FontSize="9" Foreground="#8593A0"/>
                                                <TextBlock x:Name="SelectedPowerOnText" Text="—" FontSize="15"
                                                           FontWeight="SemiBold" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Background="#171C22" CornerRadius="9" Padding="12" Margin="0,0,9,0">
                                            <StackPanel>
                                                <TextBlock Text="WEAR" FontSize="9" Foreground="#8593A0"/>
                                                <TextBlock x:Name="SelectedWearText" Text="—" FontSize="15"
                                                           FontWeight="SemiBold" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="4" Background="#171C22" CornerRadius="9" Padding="12">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="LIFE REMAINING (%)" FontSize="9"
                                                               Foreground="#8593A0"/>
                                                    <TextBlock x:Name="SelectedLifeText" DockPanel.Dock="Right"
                                                               Text="Not reported" FontWeight="SemiBold"
                                                               Foreground="#FE7F2D" Margin="8,0,0,0"/>
                                                </DockPanel>
                                                <ProgressBar x:Name="LifeProgress" Height="6" Minimum="0" Maximum="100"
                                                             Value="0" Background="#29323C" Foreground="#FE7F2D"
                                                             BorderThickness="0" Visibility="Collapsed" Margin="0,9,0,0"/>
                                                <TextBlock x:Name="LifeCaptionText"
                                                           Text="SMART remaining-life percentage is shown only when reported by a supported drive."
                                                           FontSize="9" Foreground="#8593A0" TextWrapping="Wrap"
                                                           Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="TEMPERATURE">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="2,0,0,14">
                        <TextBlock Text="Temperature history" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TemperatureHistorySubtitle"
                                   Text="Recorded readings appear here as Deviso collects them."
                                   Foreground="#A8B0B8" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#1C2025" CornerRadius="10" Padding="20">
                        <Canvas x:Name="TemperatureChart" Background="Transparent" SizeChanged="TemperatureChart_SizeChanged"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="PERFORMANCE">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="Performance tools" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Use lightweight checks for a quick view of your storage."
                                   Foreground="#A8B0B8" Margin="0,5,0,18"/>
                        <Border Background="#1C2025" CornerRadius="10" Padding="22" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Mounted-volume benchmark" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Writes and reads a temporary 64 MB test file, then removes it. Results measure the filesystem and volume path, not raw-device speed."
                                           Foreground="#BBC3C8" TextWrapping="Wrap" Margin="0,8,0,16"/>
                                <Button x:Name="BenchmarkButton" Content="Run safe benchmark"
                                        HorizontalAlignment="Left" Click="Benchmark_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1C2025" CornerRadius="10" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Filesystem check" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Runs the Windows filesystem check without requesting repairs. This is not a physical surface scan."
                                           Foreground="#BBC3C8" TextWrapping="Wrap" Margin="0,8,0,16"/>
                                <Button x:Name="CheckButton" Content="Check selected volume"
                                        HorizontalAlignment="Left" Click="Check_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1C2025" CornerRadius="10" Padding="22" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="SMART self-test (optional)" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Requires smartmontools and drive/controller support. The test runs on the drive and may take some time; it does not repair the disk."
                                           Foreground="#BBC3C8" TextWrapping="Wrap" Margin="0,8,0,16"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="SmartTestMode" SelectedIndex="0" Width="140"
                                              Background="#233D4D" Foreground="#EAECF0" Margin="0,0,10,0">
                                        <ComboBoxItem Content="Short test"/>
                                        <ComboBoxItem Content="Extended test"/>
                                    </ComboBox>
                                    <Button x:Name="SmartTestButton" Content="Start self-test"
                                            Click="SmartTest_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="REMOTE">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="Private LAN monitoring" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Read-only HTTPS monitoring. The listener binds only to private IPv4 addresses and requires a pairing token plus the server certificate fingerprint."
                                   Foreground="#A8B0B8" Margin="0,5,0,16" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#1C2025" CornerRadius="10" Padding="20" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Share this PC" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="Start a temporary, read-only LAN endpoint. Share the token and fingerprint only with a trusted peer."
                                               Foreground="#BBC3C8" TextWrapping="Wrap" Margin="0,7,0,14"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Button x:Name="StartRemoteButton" Content="Start LAN monitor" Click="StartRemote_Click"/>
                                        <Button x:Name="StopRemoteButton" Content="Stop" IsEnabled="False" Click="StopRemote_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="ENDPOINTS" FontSize="10" Foreground="#A8B0B8"/>
                                    <TextBlock x:Name="RemoteAddressesText" Text="Not running"
                                               TextWrapping="Wrap" Margin="0,4,0,12"/>
                                    <TextBlock Text="PAIRING TOKEN" FontSize="10" Foreground="#A8B0B8"/>
                                    <TextBox x:Name="RemoteTokenText" IsReadOnly="True" TextWrapping="Wrap"
                                             Background="#141619" Foreground="#FE7F2D" BorderThickness="0"
                                             Padding="8" Margin="0,4,0,12"/>
                                    <TextBlock Text="SHA-256 CERTIFICATE FINGERPRINT" FontSize="10" Foreground="#A8B0B8"/>
                                    <TextBox x:Name="RemoteFingerprintText" IsReadOnly="True" TextWrapping="Wrap"
                                             Background="#141619" Foreground="#FE7F2D" BorderThickness="0"
                                             Padding="8" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#1C2025" CornerRadius="10" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Connect to a peer" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="Enter the private IPv4 address, pairing token, and fingerprint provided by another Deviso instance."
                                               Foreground="#BBC3C8" TextWrapping="Wrap" Margin="0,7,0,14"/>
                                    <TextBlock Text="PRIVATE IPV4 ADDRESS" FontSize="10" Foreground="#A8B0B8"/>
                                    <TextBox x:Name="PeerAddressBox" Background="#141619" Foreground="#EAECF0"
                                             BorderThickness="0" Padding="9" Margin="0,4,0,10"/>
                                    <TextBlock Text="PAIRING TOKEN" FontSize="10" Foreground="#A8B0B8"/>
                                    <PasswordBox x:Name="PeerTokenBox" Background="#141619" Foreground="#EAECF0"
                                                 BorderThickness="0" Padding="9" Margin="0,4,0,10"/>
                                    <TextBlock Text="SERVER SHA-256 FINGERPRINT" FontSize="10" Foreground="#A8B0B8"/>
                                    <TextBox x:Name="PeerFingerprintBox" Background="#141619" Foreground="#EAECF0"
                                             BorderThickness="0" Padding="9" Margin="0,4,0,12"/>
                                    <Button x:Name="ConnectPeerButton" Content="Connect securely"
                                            HorizontalAlignment="Left" Click="ConnectPeer_Click"/>
                                    <TextBlock x:Name="PeerStatusText" Foreground="#A8B0B8" Margin="0,12,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Background="#1C2025" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                            <DataGrid x:Name="RemoteDriveGrid" Height="185" Visibility="Collapsed">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DEVICE" Binding="{Binding DisplayName}" Width="2*"/>
                                    <DataGridTextColumn Header="CAPACITY" Binding="{Binding Capacity}" Width="*"/>
                                    <DataGridTextColumn Header="HEALTH" Binding="{Binding Health}" Width="*"/>
                                    <DataGridTextColumn Header="TEMP" Binding="{Binding TemperatureDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="POWER-ON" Binding="{Binding PowerOnDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="WEAR" Binding="{Binding WearDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="LIFE REMAINING (%)" Binding="{Binding LifeRemainingDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="SOURCE" Binding="{Binding DataSourceDisplay}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="ALERTS &amp; REPORTS">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Alerts &amp; reports" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Set a temperature warning threshold, export drive data, and review activity."
                                       Foreground="#A8B0B8" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="SaveAlertSettingsButton" Content="Save threshold"
                                    Click="SaveAlertSettings_Click"/>
                            <Button Content="Export CSV report" Click="ExportReport_Click"/>
                            <Button Content="Open history" Click="OpenHistory_Click" Margin="0"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#1C2025" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Warn at" VerticalAlignment="Center"/>
                                <TextBox x:Name="TemperatureThresholdBox" Width="58" Text="55"
                                         Background="#141619" Foreground="#EAECF0" BorderThickness="0"
                                         Padding="8" Margin="10,0,7,0"/>
                                <TextBlock Text="°C or higher" VerticalAlignment="Center"/>
                                <TextBlock Text="  ·  Windows tray notifications are sent while Deviso is running."
                                           Foreground="#A8B0B8" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="#1C2025" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="Windows Start menu" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StartMenuShortcutStatusText"
                                               Text="Add a shortcut to launch Deviso from the Start menu."
                                               Foreground="#A8B0B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="AddStartMenuShortcutButton" Content="Add shortcut"
                                            Click="AddStartMenuShortcut_Click"/>
                                    <Button x:Name="RemoveStartMenuShortcutButton" Content="Remove shortcut"
                                            Click="RemoveStartMenuShortcut_Click" Margin="0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="2" Background="#1C2025" CornerRadius="10" Padding="18">
                            <TextBox x:Name="ActivityText" Background="Transparent" Foreground="#EAECF0"
                                     BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
